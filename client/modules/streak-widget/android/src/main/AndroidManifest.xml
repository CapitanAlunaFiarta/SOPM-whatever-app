<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!-- Widgetul de pe ecranul principal cu streak-ul (datele le scrie aplicația; vezi StreakWidgetModule). -->
    <receiver
      android:name="expo.modules.streakwidget.StreakWidgetProvider"
      android:exported="false"
      android:label="@string/streak_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/streak_widget_info" />
    </receiver>
  </application>
</manifest>
