{
  "expo": {
    "name": "Whatever",
    "slug": "whatever-app",
    "version": "2.7.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "whatever",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#070b14",
    "ios": {
      "bundleIdentifier": "com.unitbv.whatever",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.unitbv.whatever",
      "adaptiveIcon": {
        "backgroundColor": "#070b14",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "Whatever",
      "shortName": "Whatever",
      "themeColor": "#070b14",
      "backgroundColor": "#070b14",
      "lang": "ro",
      "description": "Planifică activități, confirmă-le cu GPS sau biometrie și păstrează-ți streak-ul."
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#070b14",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Whatever folosește Face ID ca să confirme activitățile care cer biometrie."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Whatever folosește Face ID ca să confirme activitățile care cer biometrie."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Whatever verifică locația doar când confirmi o activitate legată de un loc."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Whatever folosește camera doar ca să confirmi un favor cu o poză făcută la locul stabilit.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Whatever folosește pozele doar ca să îți alegi poza de profil.",
          "cameraPermission": "Whatever folosește camera doar ca să confirmi un favor cu o poză făcută la locul stabilit.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
