  "scripts": {
    "start": "expo start --port 5173",
    "android": "expo start --android --port 5173",
    "ios": "expo start --ios --port 5173",
    "web": "expo start --web --port 5173",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "expo lint",
    "export:web": "expo export -p web",
    "build:android": "npx eas-cli@latest build -p android --profile preview",
