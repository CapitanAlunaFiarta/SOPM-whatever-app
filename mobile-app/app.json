{
  "expo": {
    "name": "Whatever",
    "slug": "whatever-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.unitbv.whatever"
    },
    "android": {
      "package": "com.unitbv.whatever",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"]
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permite aplicației Whatever să folosească Face ID pentru autentificare."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite aplicației Whatever să verifice locația pentru task-uri."
        }
      ]
    ]
  }
}